# ---------------------------------------------------------------------------
# SERVER-ONLY secrets for Supabase Edge Functions.
# Set them with:  supabase secrets set --env-file supabase/.env
# NEVER copy these into the mobile app's .env
# ---------------------------------------------------------------------------

# Meta app credentials (Instagram API with Instagram Login)
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v23.0

# Extra redirect URIs (comma separated). The function's own HTTPS bridge
#   https://<project-ref>.supabase.co/functions/v1/auth/instagram/redirect
# is always allowed — that is the one you register in the Meta Developer Console.
META_ALLOWED_REDIRECT_URIS=

# Deep-link schemes the bridge may send the browser back to (app scheme + Expo Go)
APP_RETURN_SCHEMES=sociallens,exp,exps

# 32 random bytes, base64 encoded — encrypts Instagram tokens at rest (AES-256-GCM)
#   openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# App session lifetime
SESSION_TTL_DAYS=30

# CORS (web builds only). Use "*" for development.
ALLOWED_ORIGINS=*

# Optional third-party public profile provider (RapidAPI style). Leave empty to disable.
PUBLIC_PROFILE_PROVIDER_URL=
PUBLIC_PROFILE_PROVIDER_KEY=
PUBLIC_PROFILE_PROVIDER_HOST=

# Provided automatically by Supabase at runtime:
#   SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY
