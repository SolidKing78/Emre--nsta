# ---------------------------------------------------------------------------
# SocialLens — mobile environment (SAFE TO SHIP, NO SECRETS HERE)
# ---------------------------------------------------------------------------

# demo  -> Expo Go, mock account, no Instagram OAuth required
# live  -> real Instagram connection via Meta OAuth + backend (Development Build)
EXPO_PUBLIC_APP_MODE=demo

# Backend base URL (Supabase Edge Functions or any API implementing the contract)
# e.g. https://<project-ref>.supabase.co/functions/v1
EXPO_PUBLIC_API_URL=

# Meta / Instagram app id (public identifier, NOT the secret)
EXPO_PUBLIC_META_APP_ID=

# Redirect URI registered in Meta Developer Console.
# Must match exactly. Example for a development build: sociallens://oauth
EXPO_PUBLIC_META_REDIRECT_URI=sociallens://oauth

# Optional: server-side proxy used as a fallback when Instagram's public web
# endpoint rate-limits the device (see supabase/functions/public-profile).
# e.g. https://<project-ref>.supabase.co/functions/v1/public-profile
EXPO_PUBLIC_PUBLIC_PROFILE_PROXY_URL=

# ---------------------------------------------------------------------------
# SERVER-ONLY (never put these in the mobile .env — see supabase/.env.example)
#   META_APP_SECRET
#   SUPABASE_SERVICE_ROLE_KEY
#   TOKEN_ENCRYPTION_KEY
# ---------------------------------------------------------------------------
